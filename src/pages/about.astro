---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import TopicLabel from '../components/TopicLabel.astro';
import { getEntry } from 'astro:content';

const cv = await getEntry('profile', 'cv');
const entries = cv?.data.sections.flatMap((section) => section.entries) ?? [];
const communityEntries = entries.filter((entry) =>
  ['monash-aim-co-lead', 'narasio-data-science-mentor', 'goto-impact-data-analyst-mentor'].includes(entry.id)
);
---
<BaseLayout title="About | Dhiaz Rafilianza" description="Meet Muhammad Dhiaz Rafilianza: data science, visual AI research, and learning through mentoring.">
  <article class="container about-page">
    <header class="about-intro">
      <div class="about-title">
        <p class="eyebrow">A little more about me</p>
        <h1>Hi, I’m <em>Dhiaz.</em></h1>
        <p class="full-name">Muhammad Dhiaz Rafilianza</p>
        {cv?.data.location && <p class="location">{cv.data.location}</p>}
      </div>
      <div class="about-biography">
        {cv && <p>{cv.data.summary}</p>}
        <div class="about-actions">
          <a class="text-link" href="/about/cv/">Read my CV <ArrowIcon /></a>
          {cv?.data.linkedin && <a class="text-link" href={cv.data.linkedin}>LinkedIn <ArrowIcon /></a>}
        </div>
      </div>
    </header>

    <section class="about-section" aria-labelledby="curiosity-heading">
      <div class="section-title">
        <p class="eyebrow">What draws me in</p>
        <h2 id="curiosity-heading">Understanding images.<br /><em>Exploring possibilities.</em></h2>
      </div>
      <div class="about-story">
        <p>I’m interested in how deep learning models understand and generate visual information.</p>
        <p>My projects are a way to explore those ideas: connect existing tools, inspect the results, and learn from what works and what doesn’t.</p>
        <a class="text-link" href="/projects/">Explore the experiments <ArrowIcon /></a>
        <ul class="interests" aria-label="Research interests">
          <li><TopicLabel label="Deep learning" /></li>
          <li><TopicLabel label="Computer vision" /></li>
          <li><TopicLabel label="Diffusion models" /></li>
        </ul>
      </div>
    </section>

    {communityEntries.length > 0 && (
      <section class="about-section community" aria-labelledby="community-heading">
        <div class="section-title">
          <p class="eyebrow">Teaching &amp; teams</p>
          <h2 id="community-heading">Learning, and<br /><em>sharing it.</em></h2>
        </div>
        <div class="community-entries">
          {communityEntries.map((entry) => (
            <article>
              {entry.organisation && <p class="community-organisation">{entry.organisation}</p>}
              <h3>{entry.title}</h3>
              {entry.details[0] && <p class="community-description">{entry.details[0]}</p>}
            </article>
          ))}
          <a class="text-link" href="/about/cv/#leadership">More on mentoring &amp; leadership <ArrowIcon /></a>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
<style>
  .about-page { padding-bottom: 1rem; }
  .about-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem 5rem; align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem); }
  .about-title h1 { margin-top: 1.25rem; font-size: clamp(3.5rem, 7vw, 6.5rem); font-weight: 400; line-height: 1.05; }
  h1 em, h2 em { color: var(--color-accent); font-weight: 400; }
  .full-name { margin-top: 1.5rem; font-size: 0.9375rem; }
  .location { margin-top: 0.35rem; font-size: 0.8125rem; color: var(--color-muted); }
  .about-biography { padding-top: 2rem; font-size: 1rem; line-height: 1.85; }
  .about-biography > p { color: var(--color-muted); }
  .about-actions { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.5rem; }
  .about-actions a { font-size: 0.875rem; }
  .about-section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem 5rem; padding-block: 3rem 5rem; border-top: 1px solid var(--color-rule); }
  .section-title h2 { margin-top: 1.25rem; font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1.15; font-weight: 400; }
  .about-story { color: var(--color-muted); line-height: 1.8; }
  .about-story p + p { margin-top: 1rem; }
  .about-story .text-link { margin-top: 1rem; color: var(--color-ink); font-size: 0.875rem; }
  .about-story .text-link:hover { color: var(--color-accent); }
  .interests { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 2rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--color-rule); }
  .interests li { min-width: 0; max-width: 100%; }
  .community-entries article + article { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--color-rule); }
  .community-organisation { color: var(--color-accent); font-size: 0.75rem; line-height: 1.5; }
  .community-entries h3 { margin-top: 0.4rem; font-size: 1.75rem; font-weight: 400; }
  .community-description { color: var(--color-muted); font-size: 0.9375rem; line-height: 1.8; margin-top: 0.75rem; }
  .community-entries > .text-link { margin-top: 1.5rem; font-size: 0.8125rem; }
  @media (max-width: 900px) {
    .about-intro, .about-section { gap: 2rem 3rem; }
    .about-biography { padding-top: 1.5rem; }
  }
  @media (max-width: 680px) {
    .about-intro, .about-section { grid-template-columns: 1fr; }
    .about-intro { gap: 2rem; padding-bottom: 3.5rem; }
    .about-biography { padding-top: 0; }
    .about-section { padding-block: 2.5rem 3.5rem; }
    .section-title h2 { margin-top: 0.8rem; }
    .interests { margin-top: 1.5rem; }
  }
</style>
