---
import ArrowIcon from './ArrowIcon.astro';
const pathname = Astro.url.pathname;
const navigation = [
  { label: 'Home', href: '/', active: pathname === '/' },
  { label: 'Projects', href: '/projects/', active: pathname.startsWith('/projects/') },
  { label: 'About', href: '/about/', active: pathname.startsWith('/about') },
];
---
<header class="site-header container">
  <a class="wordmark" href="/" aria-label="Dhiaz Rafilianza — home">Dhiaz Rafilianza<span aria-hidden="true">.</span></a>
  <nav aria-label="Main navigation">
    {navigation.map((item) => <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <a class="cv-link text-link" href="/about/cv/">View CV <ArrowIcon /></a>
</header>
<style>
  .site-header { display: flex; align-items: center; gap: 2.5rem; min-height: 100px; padding-block: 1.25rem; border-bottom: 1px solid var(--color-rule); }
  .wordmark { display: inline-flex; align-items: baseline; min-height: 44px; margin-right: auto; padding-top: 0.25rem; font-family: var(--font-display); font-size: 1.75rem; letter-spacing: -0.055em; text-decoration: none; line-height: 1.3; white-space: nowrap; }
  .wordmark span { color: var(--color-accent); }
  nav { display: flex; align-items: center; gap: 1.75rem; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; border-bottom: 1px solid transparent; font-size: var(--text-small); color: var(--color-muted); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  .cv-link { color: var(--color-ink); }
  .cv-link svg { width: 16px; height: 16px; transform: rotate(-45deg); }
  .cv-link:hover svg { transform: rotate(-45deg) translateX(2px); }
  @media (max-width: 620px) {
    .site-header { flex-wrap: wrap; gap: 0 1rem; padding-block: 1rem 0.5rem; min-height: 0; }
    .wordmark { font-size: 1.5rem; }
    nav { order: 3; flex-basis: 100%; gap: 2rem; }
    .cv-link { font-size: 0.8125rem; }
  }
</style>
