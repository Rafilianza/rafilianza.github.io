---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'featured' | 'listing';
  priority?: boolean;
}
const { project, variant = 'listing', priority = false } = Astro.props;
const { data } = project;
const projectUrl = '/projects/' + project.id + '/';
const previewImage = data.cover ?? data.comparison?.views[0];
const Heading = variant === 'featured' ? 'h3' : 'h2';
const previewWidths = previewImage
  ? [480, 800, 1200].filter((width) => width < previewImage.src.width).concat(Math.min(1400, previewImage.src.width))
  : [];
---
<article class:list={['project-preview', variant, { 'without-image': !previewImage }]}>
  <div class="project-intro">
    {data.draft && <p class="draft-label">Draft · local preview</p>}
    {data.tags.length > 0 && <p class="project-category">{data.tags[0]}</p>}
    <Heading class="project-title"><a href={projectUrl}>{data.title}</a></Heading>
    <p class="project-summary">{data.summary}</p>
  </div>
  {previewImage && (
    <figure class="project-visual">
      <a href={projectUrl} aria-label={'Read the case study: ' + data.title}>
        <Image src={previewImage.src} alt={previewImage.alt}
          width={Math.min(1400, previewImage.src.width)}
          widths={previewWidths} sizes="(max-width: 760px) 90vw, (max-width: 1240px) 52vw, 640px"
          format="webp" quality={90}
          loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
      </a>
      {previewImage.caption && <figcaption>{previewImage.caption}</figcaption>}
    </figure>
  )}
  <div class="project-details">
    {variant === 'listing' && data.role && <p class="contribution"><strong>My contribution</strong> {data.role}</p>}
    {data.finding && <p class="finding"><strong>From the experiment</strong> {data.finding}</p>}
    {variant === 'listing' && data.technologies.length > 0 && <p class="technologies">{data.technologies.join(' · ')}</p>}
    <a class="text-link case-study-link" href={projectUrl}>Explore the case study <ArrowIcon /></a>
  </div>
</article>
<style>
  .project-preview { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); grid-template-areas: 'visual intro' 'visual details'; column-gap: clamp(2rem, 5vw, 4rem); row-gap: 1.5rem; }
  .project-intro { grid-area: intro; align-self: end; }
  .project-category { margin-bottom: 1.25rem; color: var(--color-accent); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; line-height: 1.5; }
  .project-title { font-size: clamp(2rem, 3.7vw, 3.25rem); line-height: 1.08; text-wrap: initial; }
  .project-title a { text-decoration: none; }
  .project-summary { margin-top: 1.25rem; color: var(--color-muted); font-size: 0.9375rem; line-height: 1.75; max-width: 40ch; }
  .project-visual { grid-area: visual; min-width: 0; align-self: start; }
  .project-visual a { display: block; }
  img { width: 100%; height: auto; }
  figcaption { margin-top: 0.75rem; color: var(--color-muted); font-size: 0.75rem; line-height: 1.6; }
  .project-details { grid-area: details; align-self: start; }
  .finding, .contribution { font-size: 0.8125rem; line-height: 1.7; color: var(--color-muted); max-width: 44ch; }
  .finding strong, .contribution strong { display: block; margin-bottom: 0.35rem; color: var(--color-ink); font-weight: 500; }
  .contribution + .finding { margin-top: var(--space-2); }
  .technologies { margin-top: var(--space-2); color: var(--color-muted); font-size: 0.75rem; line-height: 1.8; }
  .case-study-link { margin-top: 1.25rem; color: var(--color-accent); }
  .draft-label { margin-bottom: 1rem; }
  .listing { padding-block: var(--space-5); border-top: 1px solid var(--color-rule); }
  .without-image { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); grid-template-areas: 'intro details'; }
  @media (max-width: 760px) {
    .project-preview { grid-template-columns: 1fr; grid-template-areas: 'intro' 'visual' 'details'; gap: 1.5rem; }
    .project-title { max-width: 24ch; font-size: clamp(2.25rem, 7vw, 3rem); }
    .project-category { margin-bottom: 0.75rem; }
    .project-summary { margin-top: 1rem; max-width: 55ch; font-size: 1rem; }
    .finding, .contribution { max-width: 60ch; font-size: 0.875rem; }
    .without-image { grid-template-areas: 'intro' 'details'; }
    .listing { padding-block: var(--space-4); }
    .case-study-link { margin-top: 0.75rem; }
  }
</style>
