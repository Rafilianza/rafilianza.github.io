---
import { getEntry } from 'astro:content';
import ArrowIcon from './ArrowIcon.astro';
import CvEntries from './CvEntries.astro';

const cv = await getEntry('profile', 'cv');
const groups = [
  { id: 'experience', title: 'Work experience', number: '02' },
  { id: 'education', title: 'Education', number: '03' },
];
---
<div class="background-sections container">
  {groups.map((group) => {
    const section = cv?.data.sections.find((section) => section.id === group.id);
    return section && (
      <section class="background-section" aria-labelledby={`home-${group.id}-heading`}>
        <header class="background-heading">
          <p class="eyebrow"><span class="section-number" aria-hidden="true">{group.number}</span></p>
          <h2 id={`home-${group.id}-heading`}>{group.title}</h2>
          {group.id === 'experience' && <a class="text-link" href="/about/cv/">View full CV <ArrowIcon /></a>}
        </header>
        <CvEntries entries={section.entries} />
      </section>
    );
  })}
</div>
<style>
  .background-sections { padding-block: clamp(4rem, 8vw, 7rem) 1rem; }
  .background-section { display: grid; grid-template-columns: 190px minmax(0, 1fr); align-items: start; gap: 4rem; padding-block: 2rem; border-top: 1px solid var(--color-rule); }
  .background-section + .background-section { margin-top: 2rem; }
  .background-heading h2 { margin-top: 1rem; font-size: clamp(2rem, 3vw, 2.5rem); line-height: 1.1; font-weight: 400; }
  .background-heading a { margin-top: 1.25rem; color: var(--color-ink); font-size: 0.8125rem; }
  .background-heading a:hover { color: var(--color-accent); }
  @media (max-width: 900px) {
    .background-section { grid-template-columns: 160px minmax(0, 1fr); gap: 2.5rem; }
  }
  @media (max-width: 640px) {
    .background-section { grid-template-columns: 1fr; gap: 1.75rem; }
    .background-section + .background-section { margin-top: 1rem; }
    .background-heading h2 { margin-top: 0.75rem; }
    .background-heading a { margin-top: 0.5rem; }
  }
</style>
