---
import type { CollectionEntry } from 'astro:content';
import ImageComparison from './ImageComparison.astro';
import ArrowIcon from './ArrowIcon.astro';
interface Props { project: CollectionEntry<'projects'>; priority?: boolean; compact?: boolean; }
const { project, priority = false, compact = false } = Astro.props;
const { data } = project;
const projectUrl = `/projects/${project.id}/`;
const previewImage = data.cover ?? data.comparison?.views[0];
---
<article class:list={['project-preview', { compact, 'without-image': !data.comparison && !data.cover }]}>
  <div class="project-intro">
    {data.draft && <p class="draft-label">Draft · local preview</p>}
    <h2><a href={projectUrl}>{data.title}</a></h2>
    <p class="project-summary">{data.summary}</p>
  </div>
  {(data.comparison || data.cover) && <div class="project-visual">
    {data.comparison && !compact ? (
      <ImageComparison id={`preview-${project.id}`} {...data.comparison} description={undefined} initialView={1} eager={priority} />
    ) : previewImage && (
      <figure>
        <a href={projectUrl} aria-label={`Explore ${data.title}`}><img src={previewImage.src.src} width={previewImage.src.width} height={previewImage.src.height} alt={previewImage.alt} loading={priority ? 'eager' : 'lazy'} decoding="async" /></a>
        {previewImage.caption && !compact && <figcaption>{previewImage.caption}</figcaption>}
      </figure>
    )}
  </div>}
  <div class="project-details">
    {data.technologies.length > 0 && !compact && <p class="technologies">{data.technologies.join(' · ')}</p>}
    <a class="button" href={projectUrl}>Explore the project <ArrowIcon /></a>
  </div>
</article>
<style>
  .project-preview { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.65fr); grid-template-areas: 'intro visual' 'details visual'; column-gap: clamp(2rem, 5vw, 5rem); row-gap: 1.25rem; }
  .project-intro { grid-area: intro; align-self: end; }
  .project-details { grid-area: details; align-self: start; }
  .project-preview + .project-preview { margin-top: var(--space-7); }
  h2 { font-size: clamp(2.25rem, 3.6vw, 3.65rem); line-height: 1.08; }
  h2 a { text-decoration: none; }
  .project-summary { margin-top: 1.5rem; font-size: var(--text-lead); line-height: 1.5; max-width: 34ch; }
  .technologies { color: var(--color-muted); font-size: var(--text-small); line-height: 1.7; }
  .button { margin-top: 1.5rem; }
  .draft-label { margin-bottom: 1rem; }
  .without-image { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'details'; max-width: 58rem; }
  .without-image .project-summary { max-width: 60ch; }
  .project-visual { grid-area: visual; min-width: 0; }
  figure img { max-height: 560px; width: 100%; object-fit: contain; }
  figcaption { margin-top: 0.75rem; color: var(--color-muted); font-size: var(--text-small); }
  .compact { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
  .compact.without-image { grid-template-columns: minmax(0, 1fr); }
  .compact h2 { font-size: clamp(2rem, 3.2vw, 3.25rem); }
  .compact .project-summary { font-size: 1.125rem; }
  .compact .button { margin-top: 0; }
  .compact .project-visual { align-self: center; }
  @media (max-width: 850px) {
    .project-preview, .compact { grid-template-columns: 1fr; grid-template-areas: 'intro' 'visual' 'details'; gap: 1rem; }
    .without-image { grid-template-areas: 'intro' 'details'; }
    .project-summary { max-width: 52ch; margin-top: 1rem; }
    h2 { max-width: 24ch; }
    .technologies { margin-top: 0; }
    .button { margin-top: 1rem; }
  }
  @media (max-width: 440px) { h2 { font-size: 2rem; } }
</style>
