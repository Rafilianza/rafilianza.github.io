---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
interface Props { images: CollectionEntry<'projects'>['data']['gallery']; }
const { images } = Astro.props;
---
{images.length > 0 && (
  <section class="gallery" aria-labelledby="gallery-heading">
    <div class="gallery-intro"><h2 id="gallery-heading">A closer look</h2><p class="muted">Saved examples, with their imperfections intact.</p></div>
    <div class="gallery-grid">
      {images.map((image) => (
        <figure>
          <a class="gallery-image" href={image.src.src} aria-label={'Open full image: ' + image.alt}>
            <Image src={image.src} width={Math.min(image.src.width, 1200)} widths={[400, 700, 1200].filter((width) => width <= image.src.width)} sizes="(max-width: 720px) calc(100vw - 40px), 520px" format="webp" quality={90} alt={image.alt} loading="lazy" decoding="async" />
          </a>
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>
)}
<style>
  .gallery { margin-block: var(--space-7); }
  .gallery-intro { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-rule); }
  .gallery-intro p { font-size: var(--text-small); }
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .gallery-image { aspect-ratio: 4 / 3; display: flex; background: var(--color-surface); }
  .gallery-image :global(img) { width: 100%; height: 100%; object-fit: contain; }
  figcaption { color: var(--color-muted); margin-top: var(--space-2); font-size: var(--text-small); max-width: 65ch; }
  @media (max-width: 720px) { .gallery { margin-block: var(--space-6); } .gallery-grid { grid-template-columns: 1fr; gap: var(--space-4); } }
</style>
