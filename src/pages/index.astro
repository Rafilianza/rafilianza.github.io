---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const featuredProject = projects[0];
---
<BaseLayout title="Muhammad Dhiaz Rafilianza | Computer Vision & Deep Learning" description="Exploring deep learning, computer vision, and diffusion models through practical experiments. See the work, understand the approach, and explore the source.">
  <section class="introduction container" aria-labelledby="intro-heading">
    <h1 id="intro-heading">Muhammad Dhiaz<br />Rafilianza</h1>
    <p>Exploring deep learning,<br class="desktop-break" /> computer vision, and diffusion models.</p>
  </section>
  {featuredProject && <section class="featured-work container" aria-label="Featured work"><ProjectPreview project={featuredProject} compact priority /></section>}
  <div class="home-links container"><a class="text-link" href="/projects/">Explore all projects</a><a class="text-link" href="/about/">A little about me</a></div>
</BaseLayout>
<style>
  .introduction { display: grid; grid-template-columns: 1.35fr 1fr; align-items: end; gap: 2rem; padding-top: 1.5rem; padding-bottom: var(--space-5); }
  .introduction h1 { font-size: clamp(3rem, 5.5vw, 5.25rem); }
  .introduction > p { justify-self: end; max-width: 36ch; padding-bottom: 0.5rem; font-size: var(--text-lead); line-height: 1.5; }
  .featured-work { padding-block: var(--space-3); }
  .home-links { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; padding-top: var(--space-3); padding-bottom: var(--space-2); color: var(--color-muted); font-size: var(--text-small); }
  @media (max-width: 850px) { .introduction { grid-template-columns: 1fr; gap: 1rem; padding-bottom: 2rem; } .introduction > p { justify-self: start; } .desktop-break { display: none; } }
  @media (max-width: 440px) { .introduction { padding-top: 1rem; padding-bottom: 1.25rem; } .introduction h1 { font-size: clamp(2rem, 8.6vw, 2.5rem); } }
</style>
