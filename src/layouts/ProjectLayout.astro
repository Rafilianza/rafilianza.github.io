---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ImageComparison from '../components/ImageComparison.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import WorkflowSteps from '../components/WorkflowSteps.astro';

interface Props { project: CollectionEntry<'projects'>; headings: MarkdownHeading[]; }
const { project, headings } = Astro.props;
const { data } = project;
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const date = data.date?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={`${data.title} | Dhiaz Rafilianza`} description={data.summary} image={data.cover?.src.src} imageAlt={data.cover?.alt} draft={data.draft}>
  <article class="container case-study">
    <header class="case-intro">
      <a class="text-link back-link" href="/projects/">Back to Projects</a>
      {data.draft && <p class="draft-label">Draft · local preview only</p>}
      <h1>{data.title}</h1>
      <p class="case-summary">{data.summary}</p>
      {(date || data.role) && <dl class="project-meta">
        {date && <div><dt>Date</dt><dd>{date}</dd></div>}
        {data.role && <div><dt>Contribution</dt><dd>{data.role}</dd></div>}
      </dl>}
      <ProjectLinks links={data.links} />
    </header>

    {data.comparison ? (
      <div class="case-viewer"><ImageComparison id={`case-${project.id}`} {...data.comparison} initialView={1} eager /></div>
    ) : data.cover && (
      <figure class="case-cover"><img src={data.cover.src.src} width={data.cover.src.width} height={data.cover.src.height} alt={data.cover.alt} fetchpriority="high" />{data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}</figure>
    )}

    {data.steps.length > 0 && <div class="case-workflow"><WorkflowSteps steps={data.steps} /></div>}

    <div class="case-body">
      <aside class="case-sidebar">
        {sectionHeadings.length > 0 && <nav aria-label="Case study sections"><p>In this project</p>{sectionHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}
        {data.technologies.length > 0 && <div class="technology-list"><p>Built with</p><ul>{data.technologies.map((technology) => <li>{technology}</li>)}</ul></div>}
      </aside>
      <div class="prose"><slot /></div>
    </div>

    <ProjectGallery images={data.gallery} />

    {data.links && Object.values(data.links).some(Boolean) && <section class="source-section" aria-labelledby="source-heading"><h2 id="source-heading">Explore the source</h2><ProjectLinks links={data.links} /></section>}
  </article>
</BaseLayout>

<style>
  .case-study { padding-bottom: var(--space-5); }
  .case-intro { padding-top: var(--space-3); margin-bottom: var(--space-5); }
  .back-link { color: var(--color-muted); margin-bottom: var(--space-3); font-size: var(--text-small); }
  h1 { max-width: 21ch; font-size: clamp(2.75rem, 6vw, 5.5rem); }
  .draft-label { display: block; width: fit-content; margin-bottom: var(--space-2); }
  .case-summary { max-width: 57ch; font-size: var(--text-lead); margin-top: var(--space-3); margin-bottom: var(--space-2); }
  .project-meta { display: flex; flex-wrap: wrap; gap: 1rem 3rem; margin-block: var(--space-3); }
  dt { font-size: var(--text-small); color: var(--color-muted); }
  dd { margin: 0; }
  .case-viewer, .case-cover { max-width: 1100px; margin-inline: auto; }
  .case-cover img { width: 100%; max-height: 720px; object-fit: contain; }
  figcaption { margin-top: var(--space-2); color: var(--color-muted); }
  .case-workflow { margin-block: var(--space-5) var(--space-6); }
  .case-body { display: grid; grid-template-columns: minmax(180px, 0.7fr) minmax(0, 2fr); gap: var(--space-6); margin-top: var(--space-6); }
  .case-sidebar { font-size: var(--text-small); }
  .case-sidebar p { color: var(--color-ink); font-weight: 600; margin-bottom: 0.75rem; }
  .case-sidebar nav a { display: block; width: fit-content; padding-block: 0.5rem; color: var(--color-muted); text-decoration: none; }
  .case-sidebar nav a:hover { color: var(--color-pine); text-decoration: underline; }
  .technology-list { margin-top: var(--space-4); }
  .technology-list ul { margin: 0; padding: 0; list-style: none; color: var(--color-muted); }
  .technology-list li + li { margin-top: 0.4rem; }
  .source-section { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; background: var(--color-surface); padding: var(--space-5); margin-top: var(--space-6); }
  @media (max-width: 750px) {
    .case-body { grid-template-columns: 1fr; gap: var(--space-4); }
    .case-sidebar nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
    .case-sidebar nav p { width: 100%; margin-bottom: 0; }
    .technology-list { margin-top: 1.5rem; }
    .technology-list ul { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
    .technology-list li + li { margin: 0; }
    .source-section { padding: var(--space-3); }
    .case-workflow { margin-bottom: var(--space-5); }
  }
</style>
