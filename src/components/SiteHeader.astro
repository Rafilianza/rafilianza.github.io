---
const pathname = Astro.url.pathname;
const navigation = [
  { label: 'Home', href: '/', active: pathname === '/' },
  { label: 'Projects', href: '/projects/', active: pathname.startsWith('/projects/') },
  { label: 'About', href: '/about/', active: pathname.startsWith('/about') },
];
---
<header class="site-header container">
  <a class="wordmark" href="/" aria-label="Dhiaz Rafilianza — home">Dhiaz Rafilianza<span class="name-dot" aria-hidden="true">.</span></a>
  <nav aria-label="Main navigation">
    {navigation.map((item) => <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <a class="github-link" href="https://github.com/Rafilianza">GitHub</a>
</header>
<style>
  .site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; padding-top: 1.25rem; padding-bottom: 1.25rem; }
  .wordmark { font-family: var(--font-display); font-size: 1.6rem; font-weight: 550; letter-spacing: -0.03em; text-decoration: none; line-height: 1.1; }
  .name-dot { color: var(--color-pine); }
  nav { display: flex; gap: 0.35rem; padding: 0.3rem; background: var(--color-surface); border-radius: var(--radius-control); }
  nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0.5rem 1.4rem; font-size: 0.95rem; text-decoration: none; border-radius: var(--radius-control); }
  nav a[aria-current='page'] { background: var(--color-pine); color: var(--color-paper); font-weight: 550; }
  nav a:hover:not([aria-current]) { color: var(--color-pine); }
  .github-link { justify-self: end; display: inline-flex; align-items: center; min-height: 44px; font-size: 0.95rem; }
  @media (max-width: 720px) {
    .site-header { grid-template-columns: 1fr auto; gap: 0.75rem; padding-top: 0.75rem; padding-bottom: 1rem; }
    .wordmark { font-size: 1.5rem; }
    nav { grid-row: 2; grid-column: 1 / -1; }
    nav a { flex: 1; min-width: 0; padding-inline: 0.75rem; }
    .github-link { grid-row: 1; grid-column: 2; }
  }
</style>
