---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { getProjects } from '../../lib/projects';
const projects = await getProjects();
---
<BaseLayout title="Projects | Dhiaz Rafilianza" description="Experiments in deep learning and computer vision. See each project's purpose and findings, then explore its case study and source.">
  <section class="container projects-page" aria-labelledby="projects-heading">
    <header class="projects-intro">
      <div><p class="eyebrow">Projects & experiments</p><h1 id="projects-heading">Ideas, put<br />into <em>practice.</em></h1></div>
      <p class="projects-description">Experiments in computer vision, with the results and lessons behind them.</p>
    </header>
    <div class="project-list">
      {projects.map((project, projectIndex) => <ProjectPreview project={project} variant="listing" priority={projectIndex === 0} />)}
    </div>
  </section>
</BaseLayout>
<style>
  .projects-page { padding-bottom: var(--space-6); }
  .projects-intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: end; gap: var(--space-5); padding-block: var(--space-6); border-bottom: 1px solid var(--color-rule); margin-bottom: var(--space-5); }
  .eyebrow { margin-bottom: 1.25rem; }
  h1 { font-size: clamp(3.5rem, 7vw, 6rem); line-height: 0.98; font-weight: 400; letter-spacing: -0.045em; }
  h1 em { color: var(--color-accent); font-weight: 400; }
  .projects-description { max-width: 35ch; color: var(--color-muted); font-size: var(--text-lead); padding-bottom: 0.4rem; }
  .project-list { display: grid; gap: var(--space-6); }
  @media (max-width: 760px) {
    .projects-intro { grid-template-columns: 1fr; gap: 1.5rem; padding-block: var(--space-5); }
    .projects-description { max-width: 45ch; font-size: 1rem; }
  }
</style>
