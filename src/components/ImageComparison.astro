---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface View {
  label: string;
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
interface Props {
  id: string;
  title: string;
  description?: string;
  views: View[];
  initialView?: number;
  eager?: boolean;
}
const { id, title, description, views, initialView = 0, eager = false } = Astro.props;
const selectedView = Math.min(Math.max(initialView, 0), views.length - 1);
---
<image-viewer data-initial-view={selectedView}>
  <div class="viewer-toolbar">
    <p class="viewer-title" id={`${id}-title`}>{title}</p>
    <fieldset hidden aria-describedby={description ? `${id}-description` : undefined}>
      <legend class="visually-hidden">Saved image view</legend>
      {views.map((view, viewIndex) => (
        <label>
          <input type="radio" name={`${id}-view`} value={viewIndex} checked={viewIndex === selectedView} aria-controls={`${id}-figure-${viewIndex}`} />
          <span>{view.label}</span>
        </label>
      ))}
    </fieldset>
  </div>
  {description && <p class="viewer-description" id={`${id}-description`}>{description}</p>}
  <div class="viewer-figures">
    {views.map((view, viewIndex) => (
      <figure id={`${id}-figure-${viewIndex}`}>
        <div class="image-stage">
          <Image
            src={view.src}
            width={Math.min(view.src.width, 1600)}
            widths={[480, 800, 1200, 1600].filter((width) => width <= view.src.width)}
            sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 80px), 1120px"
            format="webp"
            quality={90}
            alt={view.alt}
            loading={eager && viewIndex === selectedView ? 'eager' : 'lazy'}
            fetchpriority={eager && viewIndex === selectedView ? 'high' : 'auto'}
            decoding="async"
          />
        </div>
        <figcaption><p><span class="view-label">{view.label}.</span> {view.caption}</p><a class="text-link full-image" href={view.src.src}>Open full image<span class="visually-hidden">: {view.label}</span></a></figcaption>
      </figure>
    ))}
  </div>
</image-viewer>

<script>
  // Without JavaScript, every saved figure remains available in document order.
  class ImageViewer extends HTMLElement {
    connectedCallback() {
      const controls = this.querySelector('fieldset');
      const figures = this.querySelectorAll('figure');
      const inputs = this.querySelectorAll<HTMLInputElement>('input[type="radio"]');
      if (!controls || figures.length === 0) return;

      const selectView = (selectedIndex: number) => {
        figures.forEach((figure, figureIndex) => {
          figure.hidden = figureIndex !== selectedIndex;
        });
      };

      selectView(Number(this.dataset.initialView ?? 0));
      controls.hidden = false;
      this.classList.add('enhanced');
      inputs.forEach((input) => {
        input.addEventListener('change', () => selectView(Number(input.value)));
      });

      // Back/Forward can restore native radio state after this element initializes.
      window.addEventListener('pageshow', () => {
        requestAnimationFrame(() => {
          const checkedInput = this.querySelector<HTMLInputElement>('input:checked');
          if (checkedInput) selectView(Number(checkedInput.value));
        });
      });
    }
  }
  if (!customElements.get('image-viewer')) customElements.define('image-viewer', ImageViewer);
</script>

<style>
  image-viewer { display: block; min-width: 0; }
  .viewer-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem 2rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .viewer-title { font-size: var(--text-small); color: var(--color-ink); }
  fieldset { display: flex; flex-wrap: wrap; gap: 0.25rem; border: 0; padding: 0; margin: 0; }
  label { position: relative; cursor: pointer; }
  input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  label span { display: flex; align-items: center; justify-content: center; min-height: 44px; height: 100%; padding: 0.5rem 1rem; border: 1px solid var(--color-rule); border-radius: var(--radius-control); font-size: var(--text-small); color: var(--color-muted); transition: color var(--duration-feedback), border-color var(--duration-feedback); }
  input:checked + span { color: var(--color-accent); border-color: var(--color-accent); background: var(--color-surface); }
  input:focus-visible + span { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  .viewer-description { margin-bottom: 1.25rem; max-width: 75ch; color: var(--color-muted); font-size: var(--text-small); }
  figure + figure { margin-top: 1.5rem; }
  .enhanced figure { margin-top: 0; }
  .image-stage { display: flex; align-items: center; justify-content: center; aspect-ratio: 3 / 2; background: var(--color-surface); }
  .image-stage :global(img) { width: 100%; height: 100%; object-fit: contain; }
  figcaption { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 0 1.5rem; margin-top: 0.75rem; font-size: var(--text-small); line-height: 1.6; color: var(--color-muted); min-height: 3em; }
  figcaption p { flex: 1 1 36ch; padding-top: 0.5rem; }
  .full-image { flex-shrink: 0; color: var(--color-accent); }
  .view-label { color: var(--color-ink); font-weight: 550; }
  @media (hover: hover) and (pointer: fine) { input:not(:checked):hover + span { color: var(--color-ink); border-color: var(--color-muted); } }
  @media (max-width: 640px) {
    label span { padding-inline: 0.8rem; }
    .viewer-toolbar { align-items: flex-start; gap: 0.75rem; }
    fieldset { width: 100%; }
    label { flex: 1; }
    .viewer-description { font-size: 0.8125rem; }
    figcaption { gap: 0.25rem; }
  }
</style>
