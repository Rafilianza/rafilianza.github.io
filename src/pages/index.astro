---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import JourneySummary from '../components/JourneySummary.astro';
import TopicLabel from '../components/TopicLabel.astro';
import { getProjects } from '../lib/projects';
import { getEntry } from 'astro:content';

const projects = await getProjects();
const featuredProject = projects[0];
const cv = await getEntry('profile', 'cv');
---
<BaseLayout pageClass="home-page" title="Muhammad Dhiaz Rafilianza | Computer Vision & Deep Learning" description="Dhiaz Rafilianza — exploring computer vision and video diffusion at Monash, with a background in data science and analytics at ByteDance and Tokopedia.">
  <section class="introduction container" aria-labelledby="intro-heading">
    <div class="hero-title">
      <p class="eyebrow">Hello, I’m Dhiaz <span class="greeting-rule" aria-hidden="true"></span></p>
      <h1 id="intro-heading">How models see.<br />How they <em>imagine.</em></h1>
    </div>
    <div class="hero-story">
      <ul class="hero-focus" aria-label="Areas of focus">
        <li><TopicLabel label="Computer vision" /></li>
        <li><TopicLabel label="Generative AI" /></li>
      </ul>
      <p>{cv?.data.homeIntroduction ?? 'I explore deep learning, computer vision, and diffusion models through practical experiments.'}</p>
      <div class="intro-links">
        <a class="text-link" href="#selected-work">Explore my work <ArrowIcon /></a>
        <a class="text-link secondary-link" href="/about/">About me <ArrowIcon /></a>
      </div>
    </div>
  </section>
  {featuredProject && (
    <section class="featured-work container" id="selected-work" aria-labelledby="work-heading">
      <div class="section-heading">
        <h2 class="eyebrow" id="work-heading"><span class="section-number" aria-hidden="true">01</span> Selected work</h2>
        <a class="text-link" href="/projects/">All projects <ArrowIcon /></a>
      </div>
      <ProjectPreview project={featuredProject} variant="featured" priority />
    </section>
  )}
  <JourneySummary />
  <section class="personal-note container" aria-labelledby="personal-heading">
    <p class="eyebrow"><span class="section-number" aria-hidden="true">04</span> Beyond the experiments</p>
    <div class="personal-content">
      <h2 id="personal-heading">Learning is better<br />when it’s <em>shared.</em></h2>
      <div>
        <p>Alongside my own research, I mentor people in data science and help lead Monash AIM, a student team working with medical imaging.</p>
        <a class="text-link" href="/about/">A little more about me <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .introduction { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 3rem; align-items: end; padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem); }
  .hero-title .eyebrow { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.75rem; color: var(--color-ink); }
  .greeting-rule { width: 2.5rem; height: 1px; background: var(--color-accent); }
  h1 { font-size: clamp(3.25rem, 6.5vw, 5.75rem); line-height: 1.02; letter-spacing: -0.045em; text-wrap: initial; }
  .hero-story { padding-bottom: 0.4rem; }
  .hero-story > p:not(.hero-focus) { max-width: 39ch; color: var(--color-muted); font-size: 0.9375rem; line-height: 1.8; }
  .hero-focus { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0 0 0.75rem; padding: 0; }
  .hero-focus li { min-width: 0; max-width: 100%; }
  .intro-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-top: 1.25rem; }
  .intro-links a { color: var(--color-accent); }
  .intro-links .secondary-link { color: var(--color-muted); }
  .section-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.25rem 1.5rem; border-top: 1px solid var(--color-rule); padding-block: 1.125rem 1.75rem; }
  .section-heading .text-link { font-size: 0.8125rem; }
  .personal-note { padding-top: var(--space-5); border-top: 1px solid var(--color-rule); margin-top: var(--space-7); }
  .personal-content { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: end; margin-top: 2rem; }
  .personal-content h2 { font-size: clamp(2.75rem, 4.5vw, 4rem); }
  .personal-content p { max-width: 43ch; color: var(--color-muted); }
  .personal-content .text-link { margin-top: 1rem; color: var(--color-accent); }
  @media (max-width: 800px) {
    .introduction { grid-template-columns: 1fr; gap: 2rem; padding-block: 3rem; }
    h1 { font-size: clamp(2.5rem, 12.3vw, 4.5rem); }
    .hero-title .eyebrow { margin-bottom: 1.5rem; }
    .hero-story > p:not(.hero-focus) { max-width: 52ch; }
    .intro-links { margin-top: 0.75rem; }
    .personal-content { grid-template-columns: 1fr; gap: 1.5rem; }
    .personal-note { margin-top: var(--space-6); }
    .section-heading { padding-bottom: 1.25rem; }
  }
</style>
