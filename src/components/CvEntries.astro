---
import type { CollectionEntry } from 'astro:content';
import TopicLabel from './TopicLabel.astro';

interface Props {
  entries: CollectionEntry<'profile'>['data']['sections'][number]['entries'];
  detailed?: boolean;
}
const { entries, detailed = false } = Astro.props;
---
<ol class:list={['cv-entries', { detailed, journey: !detailed }]}>
  {entries.map((entry) => (
    <li id={detailed ? entry.id : undefined} class:list={{ 'without-context': !entry.summary && entry.journeyTopics.length === 0 }}>
      <div class:list={['entry-heading', { 'has-date': entry.dateLabel }]}>
        <div class="entry-title">
          {!detailed && entry.dateLabel && <p class="date">{entry.dateLabel}</p>}
          <h3>{entry.title}</h3>
          {entry.organisation && <p class="organisation">{entry.organisation}</p>}
          {detailed && entry.location && <p class="location">{entry.location}</p>}
        </div>
        {detailed && entry.dateLabel && <p class="date">{entry.dateLabel}</p>}
      </div>
      {(entry.summary || (detailed ? entry.details.length > 0 : entry.journeyTopics.length > 0)) && (
        <div class="entry-body">
          {entry.summary && <p class="entry-summary">{entry.summary}</p>}
          {!detailed && entry.journeyTopics.length > 0 && (
            <ul class="journey-topics" aria-label={'Focus at ' + (entry.organisation ?? entry.title)}>
              {entry.journeyTopics.map((topic) => <li><TopicLabel label={topic} /></li>)}
            </ul>
          )}
          {detailed && entry.details.length > 0 && (
            <ul class="entry-details">
              {entry.details.map((detail) => <li>{detail}</li>)}
            </ul>
          )}
        </div>
      )}
    </li>
  ))}
</ol>
<style>
  .cv-entries { list-style: none; margin: 0; padding: 0; }
  .cv-entries > li { padding-block: 2rem; border-top: 1px solid var(--color-rule); }
  .entry-heading { display: grid; gap: 0.5rem 1.5rem; align-items: baseline; }
  .entry-heading.has-date { grid-template-columns: minmax(0, 1fr) minmax(9rem, 13rem); }
  .entry-title, .entry-body { min-width: 0; }
  h3 { font-size: 1.6rem; line-height: 1.2; font-weight: 400; text-wrap: pretty; }
  .organisation { margin-top: 0.5rem; font-size: 0.9375rem; }
  .date, .location { color: var(--color-muted); font-size: 0.8125rem; line-height: 1.6; }
  .date { text-align: right; font-variant-numeric: tabular-nums; }
  .location { margin-top: 0.2rem; }
  .entry-body { max-width: var(--reading-width); }
  .entry-summary { color: var(--color-muted); }
  .entry-details { padding-left: 1.15rem; margin: 1rem 0 0; color: var(--color-muted); }
  .entry-details li { padding-left: 0.25rem; }
  .entry-details li + li { margin-top: 0.75rem; }
  .entry-details li::marker { color: var(--color-accent); }
  .detailed .entry-body { margin-top: 1rem; }
  .detailed h3 { font-family: var(--font-body); font-size: 1.125rem; font-weight: 500; line-height: 1.45; letter-spacing: -0.02em; }
  .detailed > li:first-child { border-top: 0; padding-top: 0; }
  .detailed .entry-details:first-child { margin-top: 0; }
  .journey > li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: 1rem 2rem; align-items: start; padding-block: 1.5rem; }
  .journey > li:first-child { padding-top: 0; border-top: 0; }
  .journey > li:last-child { padding-bottom: 0; }
  .journey > li.without-context { grid-template-columns: 1fr; }
  .journey .entry-heading.has-date { grid-template-columns: 1fr; }
  .journey .date { text-align: left; margin-bottom: 0.65rem; }
  .journey h3 { font-size: clamp(1.375rem, 2vw, 1.625rem); }
  .journey .entry-summary { font-size: 0.9375rem; line-height: 1.7; }
  .journey-topics { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0.75rem 0 0; list-style: none; }
  .journey-topics li { display: flex; min-width: 0; }
  @media (max-width: 760px) {
    .entry-heading.has-date { grid-template-columns: 1fr; }
    .entry-heading > .date { grid-row: 1; text-align: left; }
    .journey > li { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 560px) {
    .cv-entries > li { padding-block: 1.75rem; }
    .journey-topics { margin-top: 0.5rem; }
  }
</style>
