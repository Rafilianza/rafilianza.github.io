---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import ImageComparison from '../components/ImageComparison.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import WorkflowSteps from '../components/WorkflowSteps.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

interface Props { project: CollectionEntry<'projects'>; headings: MarkdownHeading[]; }
const { project, headings } = Astro.props;
const { data } = project;
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const date = data.date?.toLocaleDateString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const hasLinks = data.links && Object.values(data.links).some(Boolean);
---
<BaseLayout title={data.title + ' | Dhiaz Rafilianza'} description={data.summary} image={data.cover?.src.src} imageAlt={data.cover?.alt} draft={data.draft}>
  <article class="container case-study">
    <header class="case-intro">
      <div class="case-topline">
        <a class="text-link back-link" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
        <p class="eyebrow">Case study</p>
      </div>
      {data.draft && <p class="draft-label">Draft · local preview only</p>}
      <div class="case-heading">
        <h1>{data.title}</h1>
        <div class="case-description">
          <p class="case-summary">{data.summary}</p>
          <ProjectLinks links={data.links} />
        </div>
      </div>
    </header>

    {data.comparison ? (
      <section class="case-viewer" aria-label="Explore the saved result">
        <ImageComparison id={'case-' + project.id} {...data.comparison} initialView={1} eager />
      </section>
    ) : data.cover && (
      <figure class="case-cover">
        <a href={data.cover.src.src} aria-label={'Open full image: ' + data.cover.alt}>
          <Image src={data.cover.src} width={Math.min(data.cover.src.width, 1600)} widths={[480, 800, 1200, 1600].filter((width) => width <= data.cover!.src.width)} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) calc(100vw - 80px), 1120px" format="webp" quality={90} alt={data.cover.alt} loading="eager" fetchpriority="high" />
        </a>
        {data.cover.caption && <figcaption>{data.cover.caption}</figcaption>}
      </figure>
    )}

    {(data.finding || data.limitation || date || data.role) && <dl class="project-overview">
      {data.finding && <div><dt>Observed result</dt><dd>{data.finding}</dd></div>}
      {data.limitation && <div><dt>Scope & limitations</dt><dd>{data.limitation}</dd></div>}
      {data.role && <div><dt>My contribution</dt><dd>{data.role}</dd></div>}
      {date && <div><dt>Date</dt><dd>{date}</dd></div>}
    </dl>}

    {data.steps.length > 0 && <section class="case-workflow" aria-labelledby="workflow-heading">
      <div class="workflow-intro"><p class="eyebrow">The approach</p><h2 id="workflow-heading">The pipeline at a glance.</h2></div>
      <WorkflowSteps steps={data.steps} />
    </section>}

    <div class:list={['case-body', { 'without-sidebar': sectionHeadings.length === 0 && data.technologies.length === 0 }]}>
      {(sectionHeadings.length > 0 || data.technologies.length > 0) && <aside class="case-sidebar">
        {sectionHeadings.length > 0 && <nav class="case-sections" aria-label="Case study sections">
          <p class="eyebrow">In this study</p>
          <ul>{sectionHeadings.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul>
        </nav>}
        {data.technologies.length > 0 && <div class="technology-list">
          <h2 class="eyebrow">Built with</h2>
          <ul>{data.technologies.map((technology) => <li>{technology}</li>)}</ul>
        </div>}
      </aside>}
      <div class="prose"><slot /></div>
    </div>

    <ProjectGallery images={data.gallery} />

    <footer class="case-close">
      {hasLinks && <div><p class="eyebrow">Go a little deeper</p><h2>Explore the source.</h2><ProjectLinks links={data.links} /></div>}
      <a class="text-link" href="/projects/">Back to projects <ArrowIcon /></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .case-study { padding-bottom: var(--space-5); }
  .case-intro { padding-block: var(--space-3) var(--space-5); }
  .case-topline { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: var(--space-4); }
  .back-link { color: var(--color-muted); font-size: var(--text-small); }
  .case-heading { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-5); align-items: end; }
  h1 { max-width: 24ch; font-size: clamp(2.75rem, 5.6vw, 4.75rem); font-weight: 400; line-height: 1.04; letter-spacing: -0.04em; }
  .draft-label { margin-bottom: var(--space-3); }
  .case-summary { max-width: 40ch; color: var(--color-muted); font-size: 1.0625rem; line-height: 1.7; }
  .case-description :global(.project-links) { gap: 0 1.5rem; margin-top: 1rem; font-size: 0.8125rem; }
  .case-description :global(.text-link) { color: var(--color-accent); }
  .case-cover :global(img) { width: 100%; height: auto; }
  figcaption { margin-top: var(--space-2); color: var(--color-muted); font-size: var(--text-small); }
  .project-overview { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-6); margin: var(--space-4) 0 0; padding-block: var(--space-4); border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); }
  dt { color: var(--color-ink); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.75rem; }
  dd { margin: 0; max-width: 50ch; color: var(--color-muted); font-size: 0.9375rem; line-height: 1.7; }
  .case-workflow { margin-block: var(--space-6) var(--space-7); }
  .workflow-intro { margin-bottom: var(--space-4); }
  .workflow-intro .eyebrow { margin-bottom: 0.75rem; }
  .workflow-intro h2 { font-size: clamp(2rem, 3vw, 2.75rem); }
  .case-body { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: var(--space-6); align-items: start; padding-top: var(--space-4); border-top: 1px solid var(--color-rule); }
  .case-body.without-sidebar { grid-template-columns: 1fr; }
  .case-sidebar { position: sticky; top: 2rem; }
  .case-sections ul, .technology-list ul { list-style: none; margin: 0.75rem 0 0; padding: 0; }
  .case-sections a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-size: var(--text-small); color: var(--color-muted); }
  .case-sections a:hover { color: var(--color-accent); }
  .technology-list { margin-top: var(--space-4); }
  .technology-list:first-child { margin-top: 0; }
  .technology-list li { color: var(--color-muted); font-size: 0.8125rem; line-height: 1.7; }
  .technology-list li + li { margin-top: 0.5rem; }
  .prose { max-width: var(--reading-width); }
  .case-close { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; border-top: 1px solid var(--color-rule); padding-top: var(--space-5); margin-top: var(--space-7); }
  .case-close h2 { font-size: clamp(2.5rem, 4vw, 3.5rem); margin-block: 1rem 0.5rem; }
  .case-close > .text-link { color: var(--color-accent); }
  @media (max-width: 900px) {
    .case-heading { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-4); }
    .case-body { grid-template-columns: 170px minmax(0, 1fr); gap: var(--space-4); }
  }
  @media (max-width: 760px) {
    .case-intro { padding-bottom: var(--space-4); }
    .case-topline { margin-bottom: var(--space-3); }
    .case-heading { grid-template-columns: 1fr; gap: 1.25rem; }
    h1 { max-width: 23ch; font-size: clamp(2.5rem, 9vw, 3.75rem); }
    .case-summary { max-width: 55ch; font-size: 1rem; }
    .case-description :global(.project-links) { margin-top: 0.5rem; }
    .project-overview { grid-template-columns: 1fr; gap: var(--space-3); padding-block: var(--space-3); margin-top: var(--space-3); }
    .case-workflow { margin-block: var(--space-5) var(--space-6); }
    .case-body { grid-template-columns: 1fr; gap: var(--space-4); }
    .case-sidebar { position: static; }
    .case-sections ul { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-top: 0.5rem; }
    .technology-list { margin-top: 1.25rem; }
    .technology-list ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .technology-list li + li { margin-top: 0; }
    .case-close { margin-top: var(--space-6); }
  }
</style>
