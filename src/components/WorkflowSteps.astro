---
interface Props { steps: { title: string; description: string }[]; }
const { steps } = Astro.props;
---
{steps.length > 0 && (
  <ol class="workflow" aria-label="How the approach works">
    {steps.map((step) => <li><h3>{step.title}</h3><p>{step.description}</p></li>)}
  </ol>
)}
<style>
  .workflow { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 2rem 3rem; list-style: none; padding: 0; margin: 0; }
  h3 { font-family: var(--font-body); font-size: 1.125rem; letter-spacing: -0.015em; font-weight: 550; }
  p { margin-top: 0.65rem; max-width: 32ch; color: var(--color-muted); font-size: 1rem; }
  @media (max-width: 640px) { .workflow { gap: 1.5rem; } }
</style>
